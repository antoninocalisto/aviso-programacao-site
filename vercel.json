{
 "$schema": "https://openapi.vercel.sh/vercel.json", "framework": "angular", "buildCommand": "npm run build",
 "outputDirectory": "dist/aviso-programacao-site/browser", "regions": ["gru1"],
 "functions": { "api/monitor.ts": { "maxDuration": 60 } },
 "crons": [{ "path": "/api/monitor", "schedule": "0 12 * * *" }],
 "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; base-uri 'self'; frame-ancestors 'none'" }] }]
}
