{
    "name":  "aviso-programacao-site",
    "version":  "1.0.0",
    "private":  true,
    "engines":  {
                    "node":  "22.x"
                },
    "scripts":  {
                    "start":  "ng serve",
                    "build":  "ng build",
                    "test":  "npm run test:ui \u0026\u0026 npm run test:server",
                    "test:ui":  "ng test --watch=false",
                    "test:server":  "vitest run --config vitest.server.config.ts",
                    "typecheck":  "tsc --noEmit -p tsconfig.server.json",
                    "test:e2e":  "playwright test",
                    "dev":  "tsx --env-file-if-exists=.env.local scripts/dev-server.ts",
                    "check:source":  "tsx scripts/check-source.ts"
                },
    "dependencies":  {
                         "@angular/common":  "^21.2.0",
                         "@angular/compiler":  "^21.2.0",
                         "@angular/core":  "^21.2.0",
                         "@angular/platform-browser":  "^21.2.0",
                         "@vercel/blob":  "^2.3.0",
                         "cheerio":  "^1.2.0",
                         "resend":  "^6.0.0",
                         "rxjs":  "~7.8.2",
                         "tslib":  "^2.8.1"
                     },
    "devDependencies":  {
                            "@angular/build":  "^21.2.0",
                            "@angular/cli":  "^21.2.0",
                            "@angular/compiler-cli":  "^21.2.0",
                            "@playwright/test":  "^1.56.0",
                            "@types/node":  "^22.0.0",
                            "jsdom":  "^27.0.0",
                            "tsx":  "^4.20.0",
                            "typescript":  "~5.9.3",
                            "vitest":  "^4.0.0"
                        },
    "type":  "module"
}